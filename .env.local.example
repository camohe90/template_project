# ---------------------------------------------------------------------------
# Algorand network (TestNet by default — uses free AlgoNode endpoints)
# ---------------------------------------------------------------------------
ALGORAND_NETWORK=testnet

# Organizer / treasury account that creates events, mints ticket ASAs and
# holds ticket inventory until it is sold. Must be a 25-word mnemonic.
# Generate one with:  npm run gen:account
# Then fund it from the TestNet dispenser: https://bank.testnet.algorand.network
ORGANIZER_MNEMONIC="word1 word2 ... word25"

# Account that tops up brand-new user wallets so they can pay MBR + opt-in.
# Optional — defaults to ORGANIZER_MNEMONIC if omitted.
DISPENSER_MNEMONIC=""

# Minimum spendable balance (in ALGO) every connected user is funded up to.
NEXT_PUBLIC_USER_TOPUP_ALGO=1

# ---------------------------------------------------------------------------
# Web3Auth v10 (MetaMask Embedded Wallets) — get a client id from
# https://dashboard.web3auth.io  (create a "Plug and Play" project)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_WEB3AUTH_CLIENT_ID="YOUR_WEB3AUTH_CLIENT_ID"
# sapphire_devnet (free, for testing) or sapphire_mainnet
NEXT_PUBLIC_WEB3AUTH_NETWORK=sapphire_devnet
